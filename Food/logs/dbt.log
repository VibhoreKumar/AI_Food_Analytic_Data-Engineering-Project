 %}", 'depends_on': {'macros': ['macro.dbt.run_query', 'macro.dbt.get_show_grant_sql', 'macro.dbt.get_dcl_statement_list', 'macro.dbt.call_dcl_statements']}, 'description': '', 'meta': {}, 'docs': {'show': True, 'node_color': None}, 'config': {'meta': {}, 'docs': {'show': True, 'node_color': None}}, 'patch_path': None, 'arguments': [{'name': 'relation', 'type': None, 'description': ''}, {'name': 'grant_config', 'type': None, 'description': ''}, {'name': 'should_revoke', 'type': None, 'description': ''}], 'created_at': 1786131795.589415, 'supported_languages': None}, 'macro.dbt.make_intermediate_relation': {'name': 'make_intermediate_relation', 'resource_type': 'macro', 'package_name': 'dbt', 'path': 'macros/adapters/relation.sql', 'original_file_path': 'macros/adapters/relation.sql', 'unique_id': 'macro.dbt.make_intermediate_relation', 'macro_sql': "{% macro make_intermediate_relation(base_relation, suffix='__dbt_tmp') %}\n  {{ return(adapter.dispatch('make_intermediate_relation', 'dbt')(base_relation, suffix)) }}\n{% endmacro %}", 'depends_on': {'macros': ['macro.dbt.default__make_intermediate_relation']}, 'description': '', 'meta': {}, 'docs': {'show': True, 'node_color': None}, 'config': {'meta': {}, 'docs': {'show': True, 'node_color': None}}, 'patch_path': None, 'arguments': [{'name': 'base_relation', 'type': None, 'description': ''}, {'name': 'suffix', 'type': None, 'description': ''}], 'created_at': 1786131795.5909245, 'supported_languages': None}, 'macro.dbt.default__make_intermediate_relation': {'name': 'default__make_intermediate_relation', 'resource_type': 'macro', 'package_name': 'dbt', 'path': 'macros/adapters/relation.sql', 'original_file_path': 'macros/adapters/relation.sql', 'unique_id': 'macro.dbt.default__make_intermediate_relation', 'macro_sql': '{% macro default__make_intermediate_relation(base_relation, suffix) %}\n    {{ return(default__make_temp_relation(base_relation, suffix)) }}\n{% endmacro %}', 'depends_on': {'macros': ['macro.dbt.default_