ic type and unspecified precision/scale, this can lead to unintended rounding: " ~ col_naked_numeric ~ "`") }}\n    {%- endif -%}\n{% endmacro %}', 'depends_on': {'macros': ['macro.dbt.cast']}, 'description': '', 'meta': {}, 'docs': {'show': True, 'node_color': None}, 'config': {'meta': {}, 'docs': {'show': True, 'node_color': None}}, 'patch_path': None, 'arguments': [{'name': 'columns', 'type': None, 'description': ''}], 'created_at': 1786131795.569817, 'supported_languages': None}, 'macro.dbt.get_column_schema_from_query': {'name': 'get_column_schema_from_query', 'resource_type': 'macro', 'package_name': 'dbt', 'path': 'macros/adapters/columns.sql', 'original_file_path': 'macros/adapters/columns.sql', 'unique_id': 'macro.dbt.get_column_schema_from_query', 'macro_sql': "{% macro get_column_schema_from_query(select_sql, select_sql_header=none) -%}\n    {% set columns = [] %}\n    {# -- Using an 'empty subquery' here to get the same schema as the given select_sql statement, without necessitating a data scan.#}\n    {% set sql = get_empty_subquery_sql(select_sql, select_sql_header) %}\n    {% set column_schema = adapter.get_column_schema_from_query(sql) %}\n    {{ return(column_schema) }}\n{% endmacro %}", 'depends_on': {'macros': ['macro.dbt.get_empty_subquery_sql']}, 'description': '', 'meta': {}, 'docs': {'show': True, 'node_color': None}, 'config': {'meta': {}, 'docs': {'show': True, 'node_color': None}}, 'patch_path': None, 'arguments': [{'name': 'select_sql', 'type': None, 'description': ''}, {'name': 'select_sql_header', 'type': None, 'description': ''}], 'created_at': 1786131795.5705416, 'supported_languages': None}, 'macro.dbt.get_columns_in_query': {'name': 'get_columns_in_query', 'resource_type': 'macro', 'package_name': 'dbt', 'path': 'macros/adapters/columns.sql', 'original_file_path': 'macros/adapters/columns.sql', 'unique_id': 'macro.dbt.get_columns_in_query', 'macro_sql': "{% macro get_columns_in_query(select_sql) -%}\n  {{ return(adapter.dispatch('get