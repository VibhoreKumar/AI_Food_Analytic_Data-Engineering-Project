ag = configuration_changes.target_lag -%}\n        {%- if target_lag -%}{{- log('Applying UPDATE TARGET_LAG to: ' ~ existing_relation) -}}{%- endif -%}\n        {%- set snowflake_warehouse = configuration_changes.snowflake_warehouse -%}\n        {%- if snowflake_warehouse -%}{{- log('Applying UPDATE WAREHOUSE to: ' ~ existing_relation) -}}{%- endif -%}\n\n        alter dynamic table {{ existing_relation }} set\n            {% if target_lag %}target_lag = '{{ target_lag.context }}'{% endif %}\n            {% if snowflake_warehouse %}warehouse = {{ snowflake_warehouse.context }}{% endif %}\n\n    {%- endif -%}\n\n{%- endmacro %}", 'depends_on': {'macros': ['macro.dbt.get_replace_sql']}, 'description': '', 'meta': {}, 'docs': {'show': True, 'node_color': None}, 'config': {'meta': {}, 'docs': {'show': True, 'node_color': None}}, 'patch_path': None, 'arguments': [{'name': 'existing_relation', 'type': None, 'description': ''}, {'name': 'configuration_changes', 'type': None, 'description': ''}, {'name': 'target_relation', 'type': None, 'description': ''}, {'name': 'sql', 'type': None, 'description': ''}], 'created_at': 1786131795.2336583, 'supported_languages': None}, 'macro.dbt_snowflake.snowflake__get_drop_dynamic_table_sql': {'name': 'snowflake__get_drop_dynamic_table_sql', 'resource_type': 'macro', 'package_name': 'dbt_snowflake', 'path': 'macros/relations/dynamic_table/drop.sql', 'original_file_path': 'macros/relations/dynamic_table/drop.sql', 'unique_id': 'macro.dbt_snowflake.snowflake__get_drop_dynamic_table_sql', 'macro_sql': '{% macro snowflake__get_drop_dynamic_table_sql(relation) %}\n    drop dynamic table if exists {{ relation }}\n{% endmacro %}', 'depends_on': {'macros': []}, 'description': '', 'meta': {}, 'docs': {'show': True, 'node_color': None}, 'config': {'meta': {}, 'docs': {'show': True, 'node_color': None}}, 'patch_path': None, 'arguments': [{'name': 'relation', 'type': None, 'description': ''}], 'created_at': 1786131795.2340074, 'supported_languages':